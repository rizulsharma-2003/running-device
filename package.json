{
  "name": "running-devices",
  "displayName": "Running Devices",
  "description": "Mirror and control your Android device inside VS Code, like Android Studio's Running Devices window.",
  "version": "0.3.0",
  "publisher": "RizulSharma",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#3F4FE0",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "adb",
    "android",
    "apk",
    "device",
    "emulator",
    "logcat",
    "mirror",
    "remote control",
    "running devices",
    "scrcpy",
    "screen mirroring",
    "screen recording",
    "screenshot",
    "wireless debugging"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:runningDevices.panel"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "runningDevices",
          "title": "Running Devices",
          "icon": "media/device.svg"
        }
      ]
    },
    "views": {
      "runningDevices": [
        {
          "type": "webview",
          "id": "runningDevices.view",
          "name": "Device"
        }
      ]
    },
    "commands": [
      {
        "command": "runningDevices.refresh",
        "title": "Refresh Devices",
        "category": "Running Devices",
        "icon": "$(refresh)"
      },
      {
        "command": "runningDevices.stop",
        "title": "Stop Mirroring",
        "category": "Running Devices",
        "icon": "$(debug-stop)"
      },
      {
        "command": "runningDevices.show",
        "title": "Show Running Devices",
        "category": "Running Devices"
      },
      {
        "command": "runningDevices.popOut",
        "title": "Pop Out to Window",
        "category": "Running Devices",
        "icon": "$(link-external)"
      },
      {
        "command": "runningDevices.openInEditor",
        "title": "Open in Editor Tab",
        "category": "Running Devices",
        "icon": "$(open-preview)"
      },
      {
        "command": "runningDevices.moveView",
        "title": "Move View…",
        "category": "Running Devices",
        "icon": "$(move)"
      },
      {
        "command": "runningDevices.moveToSideBar",
        "title": "Move Back to Side Bar",
        "category": "Running Devices",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "runningDevices.screenshot",
        "title": "Take Screenshot",
        "category": "Running Devices",
        "icon": "$(device-camera)"
      },
      {
        "command": "runningDevices.toggleRecording",
        "title": "Start/Stop Screen Recording",
        "category": "Running Devices",
        "icon": "$(record)"
      },
      {
        "command": "runningDevices.installApk",
        "title": "Install APK on Android Device",
        "category": "Running Devices",
        "icon": "$(desktop-download)"
      },
      {
        "command": "runningDevices.pushFile",
        "title": "Copy to Android Device",
        "category": "Running Devices",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "runningDevices.logcat",
        "title": "Logcat: Current App",
        "category": "Running Devices",
        "icon": "$(output)"
      },
      {
        "command": "runningDevices.logcatAll",
        "title": "Logcat: All Apps",
        "category": "Running Devices",
        "icon": "$(terminal)"
      },
      {
        "command": "runningDevices.launchApp",
        "title": "Launch App…",
        "category": "Running Devices",
        "icon": "$(rocket)"
      },
      {
        "command": "runningDevices.openDeepLink",
        "title": "Open Deep Link…",
        "category": "Running Devices",
        "icon": "$(link)"
      },
      {
        "command": "runningDevices.appActions",
        "title": "Current App Actions…",
        "category": "Running Devices",
        "icon": "$(package)"
      },
      {
        "command": "runningDevices.quickSettings",
        "title": "Quick Settings…",
        "category": "Running Devices",
        "icon": "$(settings-gear)"
      },
      {
        "command": "runningDevices.toggleStats",
        "title": "Toggle Performance Stats",
        "category": "Running Devices",
        "icon": "$(pulse)"
      },
      {
        "command": "runningDevices.pairWifiQr",
        "title": "Pair Device over Wi-Fi with QR Code…",
        "category": "Running Devices",
        "icon": "$(radio-tower)"
      },
      {
        "command": "runningDevices.pairWifiCode",
        "title": "Pair Device over Wi-Fi with Pairing Code…",
        "category": "Running Devices",
        "icon": "$(broadcast)"
      },
      {
        "command": "runningDevices.switchToWifi",
        "title": "Switch USB Device to Wi-Fi",
        "category": "Running Devices",
        "icon": "$(plug)"
      },
      {
        "command": "runningDevices.connectWifi",
        "title": "Connect to Device over Wi-Fi…",
        "category": "Running Devices",
        "icon": "$(link)"
      },
      {
        "command": "runningDevices.more",
        "title": "More Actions…",
        "category": "Running Devices",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "runningDevices.popOut",
          "when": "view == runningDevices.view",
          "group": "navigation@1"
        },
        {
          "command": "runningDevices.openInEditor",
          "when": "view == runningDevices.view",
          "group": "navigation@2"
        },
        {
          "command": "runningDevices.refresh",
          "when": "view == runningDevices.view",
          "group": "navigation@3"
        },
        {
          "command": "runningDevices.stop",
          "when": "view == runningDevices.view && runningDevices.mirroring",
          "group": "navigation@4"
        },
        {
          "command": "runningDevices.moveView",
          "when": "view == runningDevices.view",
          "group": "layout@1"
        }
      ],
      "editor/title": [
        {
          "command": "runningDevices.popOut",
          "when": "activeWebviewPanelId == 'runningDevices.panel'",
          "group": "navigation@1"
        },
        {
          "command": "runningDevices.moveToSideBar",
          "when": "activeWebviewPanelId == 'runningDevices.panel'",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "runningDevices.moveToSideBar",
          "when": "runningDevices.panelOpen"
        },
        {
          "command": "runningDevices.stop",
          "when": "runningDevices.mirroring"
        },
        {
          "command": "runningDevices.more",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "runningDevices.installApk",
          "when": "resourceExtname == .apk",
          "group": "navigation@90"
        },
        {
          "command": "runningDevices.pushFile",
          "when": "!explorerResourceIsFolder",
          "group": "navigation@91"
        }
      ]
    },
    "configuration": {
      "title": "Running Devices",
      "properties": {
        "runningDevices.adbPath": {
          "type": "string",
          "default": "",
          "description": "Path to the adb executable. Leave empty to auto-detect from ANDROID_HOME, ANDROID_SDK_ROOT, the default SDK location, or PATH."
        },
        "runningDevices.maxSize": {
          "type": "number",
          "default": 1600,
          "minimum": 0,
          "description": "Limit the longer side of the mirrored video, in pixels. 0 means the device's native resolution."
        },
        "runningDevices.bitRate": {
          "type": "number",
          "default": 8000000,
          "description": "Video bit rate in bits per second."
        },
        "runningDevices.maxFps": {
          "type": "number",
          "default": 60,
          "description": "Maximum frame rate of the mirrored video."
        },
        "runningDevices.stayAwake": {
          "type": "boolean",
          "default": true,
          "description": "Keep the device awake while it is plugged in and being mirrored."
        },
        "runningDevices.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start mirroring automatically when exactly one device is connected."
        },
        "runningDevices.wakeOnHover": {
          "type": "boolean",
          "default": true,
          "description": "Turn the device screen on when the mouse moves over the mirrored screen, and keep it awake while you hover."
        },
        "runningDevices.captureFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where screenshots and recordings are saved. Supports `~` and `${workspaceFolder}`. Empty means your Desktop."
        },
        "runningDevices.openCaptures": {
          "type": "boolean",
          "default": true,
          "description": "Open screenshots and recordings in VS Code after they're saved."
        },
        "runningDevices.logcatLevel": {
          "type": "string",
          "default": "V",
          "enum": [
            "V",
            "D",
            "I",
            "W",
            "E"
          ],
          "enumDescriptions": [
            "Verbose",
            "Debug",
            "Info",
            "Warning",
            "Error"
          ],
          "description": "Minimum log level shown in Logcat."
        }
      }
    }
  },
  "scripts": {
    "fetch-server": "node scripts/fetch-scrcpy-server.mjs",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview",
    "package": "npm run typecheck && node esbuild.mjs --production && vsce package --allow-missing-repository",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2",
    "qrcode": "^1.5.4"
  }
}
